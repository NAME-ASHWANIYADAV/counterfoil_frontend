{{define "myexit"}}{{template "head" .}}
{{$d := .Data}}
<div class="topbar"><h1>My exit — {{$d.C.C.ID}}</h1>
  <span class="crumb">every line below comes from a receipt; questions go to <a href="/chat">the assistant</a></span></div>
<main id="main" data-live="1">{{template "myexit-main" .}}</main>
{{template "foot" .}}{{end}}

{{define "myexit-main"}}
{{$d := .Data}}
{{$c := $d.C}}
<div class="stack">

  <div class="statstrip">
    <div class="sitem"><div class="v">{{$c.StepsDone}}<span class="of">/{{$c.StepsAll}}</span></div><div class="k">steps done</div></div>
    <div class="sitem"><div class="v">{{$d.ClocksClosed}}<span class="of">/{{$d.ClocksAll}}</span></div><div class="k">clocks closed on evidence</div></div>
    <div class="sitem"><div class="v">{{$d.Attributed}}</div><div class="k">effects confirmed in the other system's own records</div></div>
    <div class="sitem {{if $d.InDoubt}}warn{{end}}"><div class="v">{{$d.InDoubt}}</div><div class="k">in doubt — with a named person</div></div>
    <div class="sitem wide">
      {{if $c.C.BoundLWD}}<div class="v" style="font-size:15px">{{fdisplay $c.C.BoundLWD}}</div><div class="k">last working day, fixed by {{$d.ApproverName}}'s mandate</div>
      {{else}}<div class="v" style="font-size:15px">—</div><div class="k">last working day: awaiting your approver's decision</div>{{end}}
    </div>
  </div>

  <div class="card">
    <div class="hd"><h2>What happens next</h2><span class="note">read from the step engine, not a script</span></div>
    <div class="bd">
      {{if $d.Next}}
      <div class="nextrow">
        <div class="nextn">{{printf "%02d" $d.Next.N}}</div>
        <div>
          <b>{{$d.Next.Title}}</b>
          <div class="note" style="margin-top:3px">{{$d.NextWho}}</div>
        </div>
        <span class="pill p-{{$d.Next.Status}}" style="margin-left:auto">{{$d.Next.Status}}</span>
      </div>
      {{else}}
      <div class="note">Nothing is pending. {{if eq (printf "%s" $c.C.Status) "closed"}}Your case is closed — the closure
      statement is on the passbook below, and your documents remain available.{{end}}</div>
      {{end}}
    </div>
  </div>

  <div class="card">
    <div class="hd"><h2>The 19 steps</h2>
      <span class="note">people hold the diamonds; ✓ = the other team's own system shows it done</span></div>
    {{template "tracker" $c}}
  </div>

  {{if $d.Tasks}}
  <div class="card">
    <div class="hd"><h2>Waiting on you</h2><span class="note">optional means optional — declining is recorded, never punished</span></div>
    <div class="bd stack" style="gap:10px">
      {{range $d.Tasks}}
      <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
        <div><b>{{.Title}}</b><div class="note">step {{.StepID}} · optional</div></div>
        <div style="display:flex;gap:8px">
          {{if eq .StepID "survey"}}<a class="btn sm" href="/survey/{{.ID}}">Fill the survey</a>
          {{else}}<form method="post" action="/tasks/{{.ID}}/done"><input type="hidden" name="back" value="/myexit"><button class="btn sm">Fill now</button></form>{{end}}
          <form method="post" action="/tasks/{{.ID}}/skip"><input type="hidden" name="back" value="/myexit"><button class="btn sm ghost">Decline</button></form>
        </div>
      </div>
      {{end}}
    </div>
  </div>
  {{end}}

  <div class="row">
    <div class="card" style="flex:1.2;min-width:0">
      <div class="hd"><h2>My clocks</h2><span class="note">each closes only on evidence at its declared level</span></div>
      <div class="bd">{{template "clocks" $c}}</div>
    </div>
    <div class="card" style="flex:.8;min-width:0">
      <div class="hd"><h2>My documents</h2><span class="note">issued from the record; printable</span></div>
      <div class="bd stack" style="gap:8px">
        <a class="btn sm ghost" href="/settlement/{{$c.C.ID}}">Settlement statement</a>
        <a class="btn sm ghost" href="/letter/{{$c.C.ID}}">Relieving letter</a>
        <div class="note">Each document carries its stub: the receipt that issued it is linked at its foot,
        like a cheque book keeps its counterfoil.</div>
      </div>
    </div>
  </div>

  <div class="card tight">
    <div class="hd stub"><h2>My passbook</h2><span class="note">no counterfoil, no claim — these lines are receipts, not messages</span></div>
    <div class="tearline"></div>
    <div class="bd">{{template "receipts" $c.Receipts}}</div>
  </div>
</div>
{{end}}
